#version 450
layout(local_size_x = 16, local_size_y = 16) in;

// Input image buffer
layout(binding = 0) buffer InputImage {
    uint pixels[];
} inputImage;

// Output image buffer
layout(binding = 1) buffer OutputImage {
    uint pixels[];
} outputImage;

// Mask image buffer (alpha channel determines the masked region)
layout(binding = 2) buffer MaskImage {
    uint pixels[];
} maskImage;

// Push constants for image dimensions
layout(push_constant) uniform PushConstants {
    int width;
    int height;
} pushConstants;

// Helper function to convert a 32-bit uint pixel to a vec4 (RGBA)
vec4 unpackPixel(uint pixel) {
    return vec4(
        float((pixel >> 0)  & 0xFF) / 255.0,
        float((pixel >> 8)  & 0xFF) / 255.0,
        float((pixel >> 16) & 0xFF) / 255.0,
        float((pixel >> 24) & 0xFF) / 255.0
    );
}

// Helper function to pack a vec4 color into a 32-bit uint pixel
uint packPixel(vec4 color) {
    uint r = uint(clamp(color.r, 0.0, 1.0) * 255.0);
    uint g = uint(clamp(color.g, 0.0, 1.0) * 255.0);
    uint b = uint(clamp(color.b, 0.0, 1.0) * 255.0);
    uint a = uint(clamp(color.a, 0.0, 1.0) * 255.0);
    return (a << 24) | (b << 16) | (g << 8) | r;
}

// Safely gets a color from the input image with bounds checking
vec4 getColor(int x, int y) {
    x = clamp(x, 0, pushConstants.width - 1);
    y = clamp(y, 0, pushConstants.height - 1);
    uint idx = y * pushConstants.width + x;
    return unpackPixel(inputImage.pixels[idx]);
}

// Gets the mask value (from the alpha channel) for a given coordinate
float getMaskValue(int x, int y) {
    x = clamp(x, 0, pushConstants.width - 1);
    y = clamp(y, 0, pushConstants.height - 1);
    uint idx = y * pushConstants.width + x;
    uint pixel = maskImage.pixels[idx];
    // We use the alpha channel of the mask image to determine the strength
    return float((pixel >> 24) & 0xFF) / 255.0;
}


// Calculates color similarity, returning 1 for identical colors and 0 for max difference
float colorSimilarity(vec3 colorA, vec3 colorB) {
    vec3 diff = abs(colorA - colorB);
    return 1.0 - (diff.r + diff.g + diff.b) / 3.0;
}

// Enhances colors to achieve a vibrant, Ghibli-inspired look
vec3 enhanceGhibliColor(vec3 color) {
    // Increase saturation for more vibrant colors
    float luminance = dot(color, vec3(0.299, 0.587, 0.114));
    vec3 saturatedColor = mix(vec3(luminance), color, 1.7);

    // Adjust color curves for a brighter, more vivid appearance
    vec3 adjustedColor;
    adjustedColor.r = pow(saturatedColor.r, 0.8) * 1.2; // Brighten reds
    adjustedColor.g = pow(saturatedColor.g, 0.8) * 1.2; // Brighten greens
    adjustedColor.b = pow(saturatedColor.b, 0.85) * 1.2; // Slightly less boost for blues

    // Enhance specific Ghibli-esque color tones
    if (color.b > color.r && color.b > color.g) { // Sky blues
        adjustedColor.b *= 1.1;
        adjustedColor.r *= 0.9;
        adjustedColor.g *= 0.95;
    } else if (color.r > 0.5 && color.g > 0.5 && color.b < 0.5) { // Warm yellows/golds
        adjustedColor.r *= 1.15;
        adjustedColor.g *= 1.1;
    } else if (color.g > color.r && color.g > color.b) { // Foliage greens
        adjustedColor.g *= 1.15;
        adjustedColor.r *= 1.1;
    }

    return clamp(adjustedColor, 0.0, 1.0);
}

// Averages colors in a local region to create a painterly, simplified effect
vec3 applyRegionColor(uint x, uint y) {
    vec4 centerColor = getColor(int(x), int(y));

    // Parameters for region detection
    const int radius = 3;
    const float similarityThreshold = 0.95;

    // Accumulate similar colors in the neighborhood
    vec3 sumColor = vec3(0.0);
    float totalWeight = 0.0;

    for (int offsetY = -radius; offsetY <= radius; offsetY++) {
        for (int offsetX = -radius; offsetX <= radius; offsetX++) {
            vec4 neighborColor = getColor(int(x) + offsetX, int(y) + offsetY);
            float similarity = colorSimilarity(centerColor.rgb, neighborColor.rgb);

            if (similarity > similarityThreshold) {
                float dist = length(vec2(offsetX, offsetY));
                float weight = max(0.0, radius - dist) / radius; // Weight by distance
                sumColor += neighborColor.rgb * weight;
                totalWeight += weight;
            }
        }
    }

    vec3 regionColor = (totalWeight > 0.0) ? (sumColor / totalWeight) : centerColor.rgb;
    return enhanceGhibliColor(regionColor);
}

// Detects edges using a Sobel operator for creating outlines
float detectEdges(uint x, uint y) {
    // Get luminance of 3x3 neighborhood
    float tlL = dot(getColor(int(x)-1, int(y)-1).rgb, vec3(0.299, 0.587, 0.114));
    float tcL = dot(getColor(int(x),   int(y)-1).rgb, vec3(0.299, 0.587, 0.114));
    float trL = dot(getColor(int(x)+1, int(y)-1).rgb, vec3(0.299, 0.587, 0.114));
    float lcL = dot(getColor(int(x)-1, int(y)  ).rgb, vec3(0.299, 0.587, 0.114));
    float rcL = dot(getColor(int(x)+1, int(y)  ).rgb, vec3(0.299, 0.587, 0.114));
    float blL = dot(getColor(int(x)-1, int(y)+1).rgb, vec3(0.299, 0.587, 0.114));
    float bcL = dot(getColor(int(x),   int(y)+1).rgb, vec3(0.299, 0.587, 0.114));
    float brL = dot(getColor(int(x)+1, int(y)+1).rgb, vec3(0.299, 0.587, 0.114));

    // Sobel operator
    float sobelX = (trL + 2.0 * rcL + brL) - (tlL + 2.0 * lcL + blL);
    float sobelY = (blL + 2.0 * bcL + brL) - (tlL + 2.0 * tcL + trL);
    return sqrt(sobelX * sobelX + sobelY * sobelY);
}

// Quantizes color to a limited number of levels to create a cel-shaded effect
vec3 quantizeColor(vec3 color, int levels) {
    return floor(color * float(levels)) / float(levels);
}

// Applies a subtle, procedural paper-like texture
float paperTexture(vec2 uv) {
    float noise = fract(sin(dot(uv, vec2(12.9898, 78.233))) * 43758.5453);
    return noise * 0.02 - 0.01; // Reduced texture strength
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    // Boundary check
    if (x >= pushConstants.width || y >= pushConstants.height) {
        return;
    }

    uint idx = y * pushConstants.width + x;
    vec4 originalColor = unpackPixel(inputImage.pixels[idx]);
    float maskValue = getMaskValue(int(x), int(y));

    // Apply effect based on the mask
    if (maskValue < 0.5) {
        // --- MASKED REGION (PERSON) ---
        // Apply the full Ghibli stylization pipeline

        // Step 1: Calculate region-based color for a painterly feel
        vec3 regionColor = applyRegionColor(x, y);

        // Step 2: Quantize colors to create a cel-shading effect
        vec3 celShadedColor = quantizeColor(regionColor, 6);

        // Step 3: Detect edges for outlines
        float edgeStrength = detectEdges(x, y);
        bool isEdge = edgeStrength > 0.15;

        // Step 4: Apply dark outlines
        vec3 colorWithEdges = isEdge ? mix(celShadedColor, vec3(0.1, 0.1, 0.15), 0.7) : celShadedColor;

        // Step 5: Add a subtle paper texture
        vec2 uv = vec2(float(x) / float(pushConstants.width), float(y) / float(pushConstants.height));
        vec3 finalColor = colorWithEdges + paperTexture(uv);

        // Step 6: Write the final pixel, preserving the original alpha
        outputImage.pixels[idx] = packPixel(vec4(finalColor, originalColor.a));

    } else {
        // --- UNMASKED REGION (BACKGROUND) ---
        // Convert the background to grayscale

        float gray = dot(originalColor.rgb, vec3(0.299, 0.587, 0.114));
        outputImage.pixels[idx] = packPixel(vec4(vec3(gray), originalColor.a));
    }
}
